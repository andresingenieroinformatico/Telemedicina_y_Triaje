# Ejemplo de variables de entorno para Telemedicina API
# Copia este archivo a `.env` y completa los valores antes de ejecutar.

# App
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=5000

# Seguridad
SECRET_KEY=change-me
JWT_SECRET_KEY=change-jwt
JWT_ACCESS_TOKEN_EXPIRES=3600

# Base de datos (Postgres)
# Formato recomendado para SQLAlchemy: postgresql+psycopg2://<USER>:<PASS>@<HOST>:<PORT>/<DB>
DATABASE_URL=postgresql+psycopg2://admin_telemedicina:password_seguro_123@db-postgres:5432/telemedicina_agendamiento

# CORS y cookies
CORS_ORIGINS=*
JWT_TOKEN_LOCATION=headers,cookies
JWT_COOKIE_SECURE=False
JWT_COOKIE_CSRF_PROTECT=False
CORS_SUPPORTS_CREDENTIALS=True
