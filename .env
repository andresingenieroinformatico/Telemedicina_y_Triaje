# --- Configuraciones Globales ---
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production-2026

# --- Seguridad JWT ---
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production-2026
JWT_ACCESS_TOKEN_EXPIRES=3600

# --- App ---
APP_HOST=0.0.0.0

# --- Bases de Datos (Supabase) ---
# Reemplaza los corchetes con tu URL real. El código aplicará pg8000 automáticamente.
USUARIOS_DB_URL=postgresql://[usuario]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
AGENDAMIENTO_DB_URL=postgresql://[usuario]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
HISTORIAL_DB_URL=postgresql://[usuario]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
VIDEOCONFERENCIAS_DB_URL=postgresql://[usuario]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
